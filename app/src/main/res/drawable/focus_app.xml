<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground: white ring + top gloss, only while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="100">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:centerY="0.42" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:startColor="@color/c3_gloss" />
                    <corners android:radius="@dimen/c3_radius_app" />
                </shape>
            </item>
            <item>
                <shape>
                    <stroke android:width="@dimen/c3_ring" android:color="@color/c3_focus_ring" />
                    <corners android:radius="@dimen/c3_radius_app" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <color android:color="#00000000" />
    </item>
</selector>
