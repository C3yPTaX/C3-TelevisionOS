<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/c3_tile_focused" />
            <stroke android:width="2dp" android:color="@color/c3_stroke_focused" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/c3_tile" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
