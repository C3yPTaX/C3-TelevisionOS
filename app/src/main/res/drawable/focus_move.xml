<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground while a favourite is being moved: accent ring (left/right moves, OK ends). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <stroke android:width="2dp" android:color="@color/c3_accent" />
            <corners android:radius="@dimen/c3_radius_app" />
        </shape>
    </item>
</layer-list>
