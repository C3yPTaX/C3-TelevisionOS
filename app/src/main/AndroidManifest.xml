<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11 package visibility: only the apps C3 actually launches. -->
    <queries>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.amazon.firebat" />
        <package android:name="com.amazon.avod" />
        <package android:name="com.amazon.firetv.youtube" />
        <package android:name="com.amazon.firetv.youtube.tv" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="tv.twitch.android.viewer" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="de.cbc.tvnow.firetv" />
        <package android:name="com.limelight" />
        <package android:name="com.amazon.tv.launcher" />
        <package android:name="com.amazon.tv.settings.v2" />

        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DEVICE_INFO_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner_c3"
        android:icon="@drawable/ic_c3"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.C3">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.diagnostics.DiagnosticsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>
</manifest>
